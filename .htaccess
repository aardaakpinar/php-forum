# Dizin listelemeyi kapat
Options -Indexes

# Veritabani / log / sql dosyalarina web uzerinden dogrudan erisimi engelle
<FilesMatch "\.(sqlite|sqlite3|db|sql|log|ini|bak)$">
    Require all denied
</FilesMatch>

# .git, .env ve diger tum nokta ile baslayan dosya/klasorlere web erisimini
# engelle (orn. .git/ deploy edilirse tum kaynak gecmisi disari sizmasin).
RewriteEngine On
RewriteCond %{REQUEST_URI} (^|/)\.
RewriteRule .* - [F,L]

# --- Tek giris noktasi (front controller) ---
# Istenen yol gercek bir dosya ya da klasore karsilik gelmiyorsa (orn.
# /login.php, /thread.php?id=5, /profile.php?u=ali gibi eski sayfa adlari
# artik fiziksel dosya olarak mevcut degil), istegi index.php'ye yonlendir.
# Router sinifi (app/core/Router.php) istenen yola bakip dogru Controller +
# View'i calistirir. Boylece disaridan hicbir URL degismez, ama sunucuda
# tek bir PHP dosyasi (index.php) calisir.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Eski Apache/mod_rewrite kapaliysa ek guvence olarak <FilesMatch> ile de kapat
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# PHP hata mesajlarinin tarayiciya sizmasini engelle (production)
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag expose_php off
</IfModule>

# Guvenlik baslikliklari (Apache seviyesinde de tekrar edilebilir)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>
